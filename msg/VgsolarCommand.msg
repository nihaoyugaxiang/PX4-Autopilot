uint8 CMD_POSITION = 6
uint8 control_mode
int16 velocity_cms
int16 yaw_data
uint8 turn_mode
uint8 turn_direction
uint16 turn_angle_cd
uint16 turn_rate_cds
uint8 system_command
uint8 nav_mode
int32 target_x
int32 target_y
uint16 arrival_yaw_cd
uint16 arrival_radius_cm
int16 cruise_speed_cms
uint16 param_index
uint8 param_type
uint32 param_value

uint8 ORB_QUEUE_LENGTH = 16
