#!/bin/sh
# Actual VGSolar hardware from AP hwdef; no V6C revision detection.
if ! board_adc start
then
    echo "ERROR [vgsolar] ADC start failed"
fi
# PX4 flips native ICM Y/Z before applying -R.
# AP uses raw axes: PX4 YAW_90(2) * ROLL_180(8) = AP PITCH_180_YAW_270(27).
# Board reference: STM32 side up, USB side forward; confirm X/Y by physical tilt.
if ! icm42688p -s -b 1 -f 8000 -R 2 start
then
    echo "ERROR [vgsolar] ICM42688P start failed"
fi
if ! bmp388 -I -b 4 -a 0x76 start
then
    if ! bmp388 -I -b 4 -a 0x77 start
    then
        echo "ERROR [vgsolar] BMP388 not found on I2C4"
    fi
fi
if ! qmc5883l -I -b 4 -a 0x0d -R 0 start
then
    if ! qmc5883p -I -b 4 -a 0x2c -R 0 start
    then
        echo "ERROR [vgsolar] QMC5883L/P start failed on I2C4"
    fi
fi
