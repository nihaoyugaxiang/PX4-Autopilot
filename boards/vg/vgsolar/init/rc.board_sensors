#!/bin/sh
# Actual VGSolar hardware from AP hwdef; no V6C revision detection.
board_adc start
# PX4 flips native ICM Y/Z before applying -R.
# AP uses raw axes: PX4 YAW_90(2) * ROLL_180(8) = AP PITCH_180_YAW_270(27).
# Board reference: STM32 side up, USB side forward; confirm X/Y by physical tilt.
icm42688p -s -b 1 -f 8000 -R 2 start
if ! bmp388 -I -b 4 -a 0x76 start
then
    bmp388 -I -b 4 -a 0x77 start
fi

# 迁移第1步仅采集超声波输入，默认不开机启动，先完成两路台架验证。
# VGS_RNG_EN=1时启用：左UART8/ttyS7，右USART2/ttyS1；不启用任何执行器。
if param compare VGS_RNG_EN 1
then
    dyp_a02 start -l /dev/ttyS7 -r /dev/ttyS1
fi
if ! qmc5883l -I -b 4 -a 0x0d -R 0 start
then
    qmc5883p -I -b 4 -a 0x2c -R 0 start
fi
